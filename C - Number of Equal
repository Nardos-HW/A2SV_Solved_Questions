n, m = map(int, input().split())
a = list(map(int, input().split()))
b = list(map(int, input().split()))

i = j = 0
count = 0

while i < n and j < m:
    if a[i] < b[j]:
        i += 1
    elif a[i] > b[j]:
        j += 1
    else:
        ai_val = a[i]
        bi_val = b[j]
        count_a = count_b = 0
        while i < n and a[i] == ai_val:
            count_a += 1
            i += 1
        while j < m and b[j] == bi_val:
            count_b += 1
            j += 1
        count += count_a * count_b

print(count)
