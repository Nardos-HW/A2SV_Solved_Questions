t = int(input())

for _ in range(t):
    n, k = map(int, input().split())
    casinos = []
    for _ in range(n):
        l, r, real = map(int, input().split())
        casinos.append((l, r, real))
    
    casinos.sort(key=lambda x: x[0])
    got = k
    changed = True
    
    while changed:
        changed = False
        for i in range(len(casinos)):
            l, r, real = casinos[i]
            if l <= got <= r:
                got = max(got, real)
                casinos.pop(i)
                changed = True
                break
    
    print(got)
